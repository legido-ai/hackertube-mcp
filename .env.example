# HackerTube MCP — no credentials are required.
# Copy to .env only if you need to override an upstream or a local path.

# Upstream HackerTube instance.
HACKERTUBE_BASE_URL=https://hackertube.org

# Per-request timeout in milliseconds (1000-120000).
HACKERTUBE_TIMEOUT_MS=20000

# Directory for optional dataset downloads. In Docker the default is /data.
HACKERTUBE_DATA_DIR=./data

# Descriptive client identity sent to HackerTube.
HACKERTUBE_USER_AGENT=hackertube-mcp/0.1.0
